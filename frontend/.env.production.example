# Copy to .env.production and set your deployed API origin.
# Only needed if the frontend is served from a DIFFERENT origin than the API.
# When FastAPI serves the built frontend itself (the default here), leave this
# unset — the app falls back to same-origin relative requests.
#
# Never put a secret in a VITE_ variable: Vite inlines them into the client
# bundle at build time, so they ship to every visitor in plain text.
VITE_API_URL=https://your-deployment.example.com
